# ============================================================
# GizmoVault — Production Environment Variables
# ============================================================

# Server Configuration
PORT=4000
NODE_ENV=production
APP_NAME=GizmoVault
API_URL=https://api.gizmovault.in
CLIENT_URL=https://gizmovault.in

# Database Configuration (SQLite WAL mode / PostgreSQL)
DB_PATH=/var/data/gizmovault.sqlite
DB_WAL_MODE=true

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_byte_hex_string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_a_secure_32_byte_aes_key

# Supabase Authentication & Realtime
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret


# Payment Gateway (Razorpay / Stripe)
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Official WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Media & Storage (Cloudflare R2 / AWS S3 / Google Cloud Storage / Local CDN)
MEDIA_STORAGE_DRIVER=r2
MEDIA_STORAGE_DIR=/var/data/uploads
CDN_BASE_URL=https://pub-016d509dc82548c484331db82640e77b.r2.dev
MEDIA_SIGNING_SECRET=your_media_signing_hmac_secret

# Cloudflare R2 Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=gizmovault-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Notifications & Email (SMTP / SendGrid / Postmark)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.gizmovault.in
SMTP_PASS=your_smtp_password
SUPPORT_EMAIL=support@gizmovault.in
DPO_EMAIL=privacy@gizmovault.in

# Observability & Monitoring
LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id
